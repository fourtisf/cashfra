# Cashfra — Apache / Hostinger shared hosting config.
# Drop this in the subdomain's document root next to index.html.

# ── keep it out of search results ──────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── HTTPS only (a service worker will not register over plain http) ────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json          .json
</IfModule>

# ── caching: the shell and the worker must always revalidate, ─────────────
#    icons are content-stable and can sit in the browser cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>
  <FilesMatch "\.(png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html application/javascript application/json
</IfModule>

DirectoryIndex index.html

# no directory listings, and keep the repo's own files private
Options -Indexes
<FilesMatch "^(\.htaccess|\.git.*|.*\.md|.*\.sh|.*\.py|.*\.mjs|package.*\.json)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(test|deploy|\.git)(/|$)
